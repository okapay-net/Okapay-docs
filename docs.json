{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Okapay",
  "theme": "luma",
  "colors": {
    "primary": "#D4FF00",
    "light": "#A0C000",
    "dark": "#D4FF00"
  },
  "favicon": "/logo/okapay-icon.png",
  "logo": {
    "light": "/logo/okapay.png",
    "dark": "/logo/okapay.png",
    "href": "https://okapay.net"
  },
  "fonts": {
    "family": "Comfortaa",
    "heading": {
      "family": "Poppins",
      "weight": 600
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Core Features",
            "pages": [
              "accept-payments",
              "payment-links",
              "subscriptions",
              "invoicing",
              "payouts"
            ]
          },
          {
            "group": "Merchant Account",
            "pages": [
              "merchant-id",
              "merchant-api-keys",
              "customers",
              "transactions",
              "disputes"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/php",
              "integrations/laravel",
              "integrations/wordpress"
            ]
          },
          {
            "group": "Platform & Security",
            "pages": [
              "security",
              "pricing"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://okapay.net/contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.okapay.net/"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/okapay",
      "github": "https://github.com/pkpayplus/pkpayplus-php",
      "linkedin": "https://www.linkedin.com/company/okapay-net"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Dashboard", "href": "https://dashboard.okapay.net/" },
          { "label": "Documentation", "href": "/" },
          { "label": "Support", "href": "mailto:help@okapay.net" }
        ]
      },
      {
        "header": "Company",
        "items": [
          { "label": "Phone", "href": "tel:+447853756631" },
          { "label": "Contact", "href": "https://okapay.net/contact" }
        ]
      },
      {
        "header": "Community",
        "items": [
          { "label": "GitHub", "href": "https://github.com/pkpayplus/pkpayplus-php" }
        ]
      }
    ]
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "decoration": "gradient"
  },
  "seo": {
    "metatags": {
      "description": "Build with Okapay payment infrastructure for global cards, wallets, crypto, subscriptions, invoicing, and payouts.",
      "og:site_name": "Okapay Documentation",
      "theme-color": "#D4FF00"
    }
  }
}
